            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(oversold_units), 0) AS \"units\" FROM inventory_daily WHERE report_date = (SELECT max(report_date) FROM inventory_daily)"
        }
