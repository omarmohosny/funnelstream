    {
      "id": 3,
      "type": "stat",
      "title": "Oversold units, latest day",
      "description": "Units asked for beyond the shelf on the latest day. A lower bound: a sale of zero units emits no movement.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
