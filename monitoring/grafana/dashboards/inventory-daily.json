            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT report_date::timestamp AS \"time\", max(max_delivery_minutes) AS \"slowest\", 20 AS \"promise\" FROM express_daily WHERE $__timeFilter(report_date::timestamp) GROUP BY 1 ORDER BY 1"
