    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Closing stock by store (units)",
      "description": "Stock at the end of each Cairo day, summed per dark store.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT i.report_date::timestamp AS \"time\", s.store_name AS \"metric\", sum(i.closing_on_hand) AS \"units\" FROM inventory_daily i JOIN dim_store s ON s.store_id = i.store_id WHERE $__timeFilter(i.report_date::timestamp) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Units sold, received and shrunk per day",
      "description": "Daily movement totals over all stores and products.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT report_date::timestamp AS \"time\", sum(units_sold) AS \"sold\", sum(units_received) AS \"received\", sum(units_shrunk) AS \"shrunk\" FROM inventory_daily WHERE $__timeFilter(report_date::timestamp) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Lowest days of cover, latest day (20 products)",
      "description": "Closing stock divided by the average units sold per day over the last 7 days; products that did not sell are left out.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.store_name AS \"store\", coalesce(p.name, i.product_id) AS \"product\", i.closing_on_hand AS \"closing stock\", round(a.per_day, 1) AS \"sold per day\", round(i.closing_on_hand / nullif(a.per_day, 0), 1) AS \"days of cover\" FROM inventory_daily i JOIN dim_store s ON s.store_id = i.store_id LEFT JOIN dim_product_current p ON p.product_id = i.product_id JOIN (SELECT store_id, product_id, sum(units_sold)::numeric / 7 AS per_day FROM inventory_daily WHERE report_date > (SELECT max(report_date) FROM inventory_daily) - 7 GROUP BY 1, 2) a ON a.store_id = i.store_id AND a.product_id = i.product_id WHERE i.report_date = (SELECT max(report_date) FROM inventory_daily) AND a.per_day > 0 ORDER BY 5 ASC NULLS LAST LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
