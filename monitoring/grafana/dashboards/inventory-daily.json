    {
      "id": 10,
      "type": "stat",
      "title": "Express on-time rate, latest day",
      "description": "On-time orders divided by delivered or breached orders on the latest day in express_daily. 100 when there is nothing to measure.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(round(100.0 * sum(on_time) / nullif(sum(on_time) + sum(breached), 0), 1), 100) AS \"percent\" FROM express_daily WHERE report_date = (SELECT max(report_date) FROM express_daily)"
