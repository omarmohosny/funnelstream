    {
      "id": 11,
      "type": "timeseries",
      "title": "Slowest express delivery per day (minutes)",
      "description": "The longest delivery time of each Cairo day against the 20-minute promise.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 23,
