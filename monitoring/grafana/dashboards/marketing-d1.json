      "id": 1,
      "type": "stat",
      "title": "Spend (EGP)",
      "description": "Ad spend of the latest D-1 day (the ad platform's UTC day), all campaigns.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(spend), 0) AS \"spend\" FROM marketing_d1_campaign WHERE report_date = (SELECT max(report_date) FROM marketing_d1_campaign)"
