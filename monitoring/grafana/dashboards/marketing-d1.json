    {
      "id": 6,
      "type": "stat",
      "title": "Out-of-stock click share",
      "description": "Landing clicks in minutes flagged out of stock, divided by all landing clicks in served districts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(oos_clicks)::numeric / nullif(sum(served_clicks), 0), 0) AS \"share\" FROM marketing_d1_campaign WHERE report_date = (SELECT max(report_date) FROM marketing_d1_campaign)"
