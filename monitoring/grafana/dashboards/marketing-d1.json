    {
      "id": 7,
      "type": "table",
      "title": "Campaigns, sorted by exposed spend",
      "description": "One row per campaign with spend on the latest D-1 day; provisional marks days whose delivered revenue can still grow.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT campaign_id, utm_campaign, spend, orders_placed, cpa, roas_placed, roas_delivered, served_clicks, oos_clicks, oos_click_share, exposed_spend, provisional FROM marketing_d1_campaign WHERE report_date = (SELECT max(report_date) FROM marketing_d1_campaign) ORDER BY exposed_spend DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top 5 products by revenue at risk",
      "description": "Out-of-stock add-to-carts times price on the latest D-1 day. The mart keeps every out-of-stock product; the limit is this panel's.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.store_name AS \"store\", coalesce(p.name, m.product_id) AS \"product\", m.oos_add_to_carts, m.revenue_at_risk FROM marketing_d1_product m JOIN dim_store s ON s.store_id = m.store_id LEFT JOIN dim_product_current p ON p.product_id = m.product_id WHERE m.report_date = (SELECT max(report_date) FROM marketing_d1_product) ORDER BY m.revenue_at_risk DESC NULLS LAST LIMIT 5"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "type": "text",
      "title": "About this data",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Simulated data. Exposed spend = spend x out-of-stock landing clicks / served landing clicks, both counted in served districts; it is an estimate that assumes spend is spread evenly over served landing clicks. The out-of-stock flag is the stock when the minute was written, which a replay can change. Spend is the ad platform's UTC day, orders and demand are the Cairo day: they differ by at most 3 hours. Recent days are provisional: ROAS delivered matures after 1 to 3 days."
      }
    }
