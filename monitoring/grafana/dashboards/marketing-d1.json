    {
      "id": 3,
      "type": "stat",
      "title": "ROAS placed",
      "description": "Placed revenue divided by spend on the latest D-1 day.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
