    {
      "id": 3,
      "type": "stat",
      "title": "In-stock rate",
      "description": "Share of tracked products with available stock.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE available > 0) / nullif(count(*), 0), 1) AS \"in stock %\" FROM live_stock_now WHERE store_id IN ($store)"
        }
