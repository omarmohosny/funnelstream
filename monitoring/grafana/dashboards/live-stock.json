    {
      "id": 5,
      "type": "stat",
      "title": "Seconds since the last stock write",
      "description": "Age of the newest stock row; about one Silver batch behind.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
