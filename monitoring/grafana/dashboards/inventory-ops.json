    {
      "id": 12,
      "type": "stat",
      "title": "On-time rate, last hour",
      "description": "On-time orders divided by delivered or breached orders created in the last hour. Cancelled and returned undelivered orders are in neither count.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE delivered_at IS NOT NULL AND delivered_at - created_at <= promised_minutes * interval '1 minute') / nullif(count(*) FILTER (WHERE (delivered_at IS NOT NULL AND delivered_at - created_at <= promised_minutes * interval '1 minute') OR ((delivered_at IS NOT NULL AND delivered_at - created_at > promised_minutes * interval '1 minute') OR (delivered_at IS NULL AND NOT closed_without_delivery AND now() - created_at > promised_minutes * interval '1 minute' + interval '1 minute'))), 0), 1) AS \"on time %\" FROM live_express_orders WHERE created_at >= now() - interval '1 hour'"
        }
