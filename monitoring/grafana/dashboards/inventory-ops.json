          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"breaches\" FROM live_express_orders WHERE created_at >= now() - interval '1 hour' AND ((delivered_at IS NOT NULL AND delivered_at - created_at > promised_minutes * interval '1 minute') OR (delivered_at IS NULL AND NOT closed_without_delivery AND now() - created_at > promised_minutes * interval '1 minute' + interval '1 minute'))"
