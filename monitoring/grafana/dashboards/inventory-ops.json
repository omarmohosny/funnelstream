    {
      "id": 8,
      "type": "table",
      "title": "Lost demand now (last 15 minutes)",
      "description": "Products with the most add-to-carts while out of stock in the last 15 minutes (stock when the minute was written).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
