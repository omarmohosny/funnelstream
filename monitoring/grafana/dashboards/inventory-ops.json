    {
      "id": 13,
      "type": "stat",
      "title": "Slowest express delivery, last hour (minutes)",
      "description": "Longest elapsed time: the delivery time of delivered orders, the age of open orders that are not closed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 23,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(max(EXTRACT(EPOCH FROM (coalesce(delivered_at, now()) - created_at)) / 60.0)::numeric, 1) AS \"minutes\" FROM live_express_orders WHERE created_at >= now() - interval '1 hour' AND (delivered_at IS NOT NULL OR NOT closed_without_delivery)"
        }
