          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(minute_start, '1m', 0), sum(views) AS \"views\", sum(add_to_cart) AS \"add to cart\" FROM live_oos_demand_minute WHERE oos_at_write AND $__timeFilter(minute_start) GROUP BY 1 ORDER BY 1"
