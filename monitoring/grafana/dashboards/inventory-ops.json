    {
      "id": 5,
      "type": "timeseries",
      "title": "Demand on out-of-stock products per minute",
      "description": "Product views and add-to-carts that arrived for a store and product with zero stock when the minute was written (the stock when the minute was written, not at event time). Demand the shelf could not serve.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fs-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
