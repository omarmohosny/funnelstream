          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.store_name AS \"store\", coalesce(p.name, l.product_id) AS \"product\", l.available AS \"available\", l.reorder_point AS \"reorder point\" FROM live_stock_now l JOIN dim_store s ON s.store_id = l.store_id LEFT JOIN dim_product_current p ON p.product_id = l.product_id ORDER BY l.available ASC, l.store_id, l.product_id LIMIT 20"
