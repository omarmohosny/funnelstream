                "value": 15
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "–",
                  "color": "text"
                }
              }
            }
          ],
          "decimals": 1,
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
