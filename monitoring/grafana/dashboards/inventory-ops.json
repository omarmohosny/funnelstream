          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.store_name AS \"store\", coalesce(p.name, d.product_id) AS \"product\", sum(d.add_to_cart) AS \"add to cart\", sum(d.views) AS \"views\" FROM live_oos_demand_minute d JOIN dim_store s ON s.store_id = d.store_id LEFT JOIN dim_product_current p ON p.product_id = d.product_id WHERE d.oos_at_write AND d.minute_start >= now() - interval '15 minutes' GROUP BY d.store_id, s.store_name, d.product_id, p.name ORDER BY 3 DESC, 4 DESC LIMIT 10"
