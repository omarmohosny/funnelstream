            "uid": "fs-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(minute_start, '1m', 0), sum(events) AS \"events\" FROM live_metrics_minute WHERE $__timeFilter(minute_start) GROUP BY 1 ORDER BY 1"
        }
