POSTGRES_USER=fs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=funnelstream

# Databricks (fill in locally, never commit)
# DATABRICKS_HOST: the workspace URL, for example https://adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_TOKEN: Databricks UI, Settings, Developer, Access tokens, Generate new token.
# DATABRICKS_WAREHOUSE_ID: SQL Warehouses, open your warehouse, Connection details (the last part of the HTTP path).
#   Alternatively set DATABRICKS_HTTP_PATH to the whole HTTP path; one of the two is needed.
# DATABRICKS_CATALOG: a Free Edition workspace may not let you create a catalog; use an existing one such as
#   workspace. The schemas gold and silver and the volume below are created inside it by scripts/apply_ddl.py.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_HTTP_PATH=
GOLD_BACKEND=postgres

# PostgreSQL DSN
PG_DSN=postgresql://fs:change_me@localhost:5432/funnelstream

# Mock API and simulator
AD_API_URL=http://localhost:8000
SIM_SEED=42

# Databricks catalog and volume
DATABRICKS_CATALOG=funnelstream
DATABRICKS_VOLUME=silver_upload
