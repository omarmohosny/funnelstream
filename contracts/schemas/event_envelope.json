{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Envelope",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "event_time", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for the event"
    },
    "event_type": {
      "type": "string",
      "description": "Type of event"
    },
    "event_version": {
      "type": "integer",
      "description": "Version of the event schema"
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the event occurred"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier (required for app events)"
    },
    "order_id": {
      "type": "string",
      "description": "Order identifier (required for order and delivery events)"
    },
    "payload": {
      "type": "object",
      "description": "Event payload with type-specific data"
    }
  }
}
