model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Date","Campaign","Product","Campaign Daily","Funnel Daily","Orders Daily","Orders","City Product Daily","Order Lines","Customer","Store","Stock Now","Inventory Daily","OOS Demand Daily","Express Daily","Marketing D1 Campaign","Marketing D1 Product","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Campaign
ref table Product
ref table 'Campaign Daily'
ref table 'Funnel Daily'
ref table 'Orders Daily'
ref table Orders
ref table 'City Product Daily'
ref table 'Order Lines'
ref table Customer
ref table Store
ref table 'Stock Now'
ref table 'Inventory Daily'
ref table 'OOS Demand Daily'
ref table 'Express Daily'
ref table 'Marketing D1 Campaign'
ref table 'Marketing D1 Product'
ref table _Measures

