table 'OOS Demand Daily'

	column report_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: report_date

	column store_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: store_id

	column product_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_id

	column campaign_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: campaign_id

	column utm_campaign
		dataType: string
		summarizeBy: none
		sourceColumn: utm_campaign

	column served_views
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: served_views

	column served_add_to_cart
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: served_add_to_cart

	column served_clicks
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: served_clicks

	column oos_views
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: oos_views

	column oos_add_to_cart
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: oos_add_to_cart

	column oos_clicks
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: oos_clicks

	partition 'OOS Demand Daily' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database("localhost:5432", "funnelstream"),
				Raw = Source{[Schema = "public", Item = "oos_demand_daily"]}[Data],
				Selected = Table.SelectColumns(Raw, {"report_date", "store_id", "product_id", "campaign_id", "utm_campaign", "served_views", "served_add_to_cart", "served_clicks", "oos_views", "oos_add_to_cart", "oos_clicks"})
			in
				Selected
