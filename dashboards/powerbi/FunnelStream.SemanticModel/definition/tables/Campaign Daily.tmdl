				Raw = Gold{[Name = "agg_campaign_daily", Kind = "Table"]}[Data],
				Filtered = Table.SelectRows(Raw, each [attribution_model] = "last_touch"),
				Selected = Table.SelectColumns(Filtered, {"campaign_id", "report_date", "ad_platform", "impressions", "clicks", "platform_conversions", "spend", "orders_placed", "orders_delivered", "orders_cancelled", "orders_returned", "orders_with_failed_attempt", "revenue_placed", "revenue_delivered", "cancel_rate", "failed_attempt_rate", "return_rate", "open_rate", "new_customer_orders", "aov", "ctr", "conversion_rate", "cpa", "cost_per_delivered_order", "roas_placed", "roas_delivered"})
