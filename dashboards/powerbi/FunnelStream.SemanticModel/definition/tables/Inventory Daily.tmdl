table 'Inventory Daily'

	column report_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		summarizeBy: none
		sourceColumn: report_date

	column store_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: store_id

	column product_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: product_id

	column closing_on_hand
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: closing_on_hand

	column units_sold
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: units_sold

	column units_received
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: units_received

	column units_shrunk
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: units_shrunk

	column units_adjusted
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: units_adjusted

	column oversold_units
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: oversold_units

	column ended_out_of_stock
		dataType: boolean
		summarizeBy: none
		sourceColumn: ended_out_of_stock

	partition 'Inventory Daily' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database("localhost:5432", "funnelstream"),
				Raw = Source{[Schema = "public", Item = "inventory_daily"]}[Data],
				Selected = Table.SelectColumns(Raw, {"report_date", "store_id", "product_id", "closing_on_hand", "units_sold", "units_received", "units_shrunk", "units_adjusted", "oversold_units", "ended_out_of_stock"})
			in
				Selected
