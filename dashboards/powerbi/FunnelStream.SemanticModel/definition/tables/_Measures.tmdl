table _Measures

	measure Spend =
			SUM ( 'Campaign Daily'[spend] )
		formatString: "#,0"
		displayFolder: Campaign\Base

	measure Impressions =
			SUM ( 'Campaign Daily'[impressions] )
		formatString: "#,0"
		displayFolder: Campaign\Base

	measure 'Ad Clicks' =
			SUM ( 'Campaign Daily'[clicks] )
		formatString: "#,0"
		displayFolder: Campaign\Base

	measure 'Platform Conversions' =
			SUM ( 'Campaign Daily'[platform_conversions] )
		formatString: "#,0"
		displayFolder: Campaign\Base

	measure 'Attributed Orders' =
			SUM ( 'Campaign Daily'[orders_placed] )
		formatString: "#,0"
		displayFolder: Campaign\Base

	measure 'Attributed Revenue Placed' =
			SUM ( 'Campaign Daily'[revenue_placed] )
		formatString: "#,0"
		displayFolder: Campaign\Base

	measure 'Attributed Revenue Delivered' =
			SUM ( 'Campaign Daily'[revenue_delivered] )
		formatString: "#,0"
		displayFolder: Campaign\Base

	measure 'Orders on Spend Days' =
			CALCULATE ( [Attributed Orders], KEEPFILTERS ( 'Campaign Daily'[spend] > 0 ) )
		formatString: "#,0"
		displayFolder: Campaign\Spend days only

	measure 'Delivered Orders on Spend Days' =
			CALCULATE ( SUM ( 'Campaign Daily'[orders_delivered] ), KEEPFILTERS ( 'Campaign Daily'[spend] > 0 ) )
		formatString: "#,0"
		displayFolder: Campaign\Spend days only

	measure 'Revenue Placed on Spend Days' =
			CALCULATE ( [Attributed Revenue Placed], KEEPFILTERS ( 'Campaign Daily'[spend] > 0 ) )
		formatString: "#,0"
		displayFolder: Campaign\Spend days only

	measure 'Revenue Delivered on Spend Days' =
			CALCULATE ( [Attributed Revenue Delivered], KEEPFILTERS ( 'Campaign Daily'[spend] > 0 ) )
		formatString: "#,0"
		displayFolder: Campaign\Spend days only

	measure CTR =
			DIVIDE ( [Ad Clicks], [Impressions] )   // API-reported clicks; not the click used for attribution
		formatString: "0.0%"
		displayFolder: Campaign\Ratios

	measure 'Conversion Rate' =
			DIVIDE ( [Orders on Spend Days], [Ad Clicks] )   // attributed orders per API click
		formatString: "0.0%"
		displayFolder: Campaign\Ratios

	measure CPA =
			DIVIDE ( [Spend], [Orders on Spend Days] )
		formatString: "#,0"
		displayFolder: Campaign\Ratios

	measure 'Cost per Delivered Order' =
			DIVIDE ( [Spend], [Delivered Orders on Spend Days] )
		formatString: "#,0"
		displayFolder: Campaign\Ratios

	measure 'ROAS Placed' =
			DIVIDE ( [Revenue Placed on Spend Days], [Spend] )
		formatString: "0.00"
		displayFolder: Campaign\Ratios

	measure 'ROAS Delivered' =
			DIVIDE ( [Revenue Delivered on Spend Days], [Spend] )   // the headline: what the cash actually returns
		formatString: "0.00"
		displayFolder: Campaign\Ratios

	measure 'ROAS Gap' =
			// How much of the placed ROAS is lost to cancellations, returns and failed COD deliveries.
			VAR Placed = [ROAS Placed]
			VAR Delivered = [ROAS Delivered]
			RETURN
				IF ( NOT ISBLANK ( Placed ) && NOT ISBLANK ( Delivered ), Placed - Delivered )
		formatString: "0.00"
		displayFolder: Campaign\Ratios

	measure 'Platform vs Attributed' =
			// Conversions the ad platform reports divided by orders we attribute. Above 1 means the platform claims more.
			DIVIDE ( [Platform Conversions], [Orders on Spend Days] )
		formatString: "0.00"
		displayFolder: Campaign\Ratios

	measure 'Is Provisional' =
			VAR LastDay = MAX ( 'Date'[Date] )
			RETURN
				LastDay >= TODAY () - 3
		displayFolder: Campaign\Maturity

	measure 'Maturity Label' =
			IF ( [Is Provisional], "Provisional: orders still settling", "Settled" )
		displayFolder: Campaign\Maturity

	measure Sessions =
			SUM ( 'Funnel Daily'[sessions] )
		formatString: "#,0"
		displayFolder: Funnel

	measure 'Product View Sessions' =
			SUM ( 'Funnel Daily'[product_views] )
		formatString: "#,0"
		displayFolder: Funnel

	measure 'Cart Sessions' =
			SUM ( 'Funnel Daily'[cart_sessions] )
		formatString: "#,0"
		displayFolder: Funnel

	measure 'Checkout Sessions' =
			SUM ( 'Funnel Daily'[checkout_sessions] )
		formatString: "#,0"
		displayFolder: Funnel

	measure 'Funnel Orders' =
			SUM ( 'Funnel Daily'[orders] )
		formatString: "#,0"
		displayFolder: Funnel

	measure 'View Rate' =
			DIVIDE ( [Product View Sessions], [Sessions] )
		formatString: "0.0%"
		displayFolder: Funnel

	measure 'Cart Rate' =
			DIVIDE ( [Cart Sessions], [Product View Sessions] )
		formatString: "0.0%"
		displayFolder: Funnel

	measure 'Checkout Rate' =
			DIVIDE ( [Checkout Sessions], [Cart Sessions] )
		formatString: "0.0%"
		displayFolder: Funnel

	measure 'Order Rate' =
			DIVIDE ( [Funnel Orders], [Checkout Sessions] )
		formatString: "0.0%"
		displayFolder: Funnel

	measure 'Session Conversion' =
			DIVIDE ( [Funnel Orders], [Sessions] )
		formatString: "0.0%"
		displayFolder: Funnel

	measure 'Cart Abandon Rate' =
			1 - DIVIDE ( [Funnel Orders], [Cart Sessions] )   // Gold definition
		formatString: "0.0%"
		displayFolder: Funnel

	measure 'Checkout Abandon Rate' =
			1 - DIVIDE ( [Funnel Orders], [Checkout Sessions] )   // Gold definition
		formatString: "0.0%"
		displayFolder: Funnel

	measure 'Orders Placed' =
			SUM ( 'Orders Daily'[orders_placed] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'Orders Delivered' =
			SUM ( 'Orders Daily'[orders_delivered] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'Orders Cancelled' =
			SUM ( 'Orders Daily'[orders_cancelled] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'Orders Returned' =
			SUM ( 'Orders Daily'[orders_returned] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'Orders with Failed Attempt' =
			SUM ( 'Orders Daily'[orders_with_failed_attempt] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'Revenue Placed' =
			SUM ( 'Orders Daily'[revenue_placed] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'Revenue Delivered' =
			SUM ( 'Orders Daily'[revenue_delivered] )   // counted on the ORDER date (cohort view)
		formatString: "#,0"
		displayFolder: Executive

	measure AOV =
			DIVIDE ( [Revenue Placed], [Orders Placed] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'Delivered Share of Revenue' =
			DIVIDE ( [Revenue Delivered], [Revenue Placed] )
		formatString: "0.0%"
		displayFolder: Executive

	measure 'Cancel Rate' =
			DIVIDE ( [Orders Cancelled], [Orders Placed] )
		formatString: "0.0%"
		displayFolder: Executive

	measure 'Return Rate' =
			DIVIDE ( [Orders Returned], [Orders Placed] )
		formatString: "0.0%"
		displayFolder: Executive

	measure 'Failed Attempt Rate' =
			DIVIDE ( [Orders with Failed Attempt], [Orders Placed] )
		formatString: "0.0%"
		displayFolder: Executive

	measure 'New Customer Orders' =
			SUM ( 'Orders Daily'[new_customer_orders] )
		formatString: "#,0"
		displayFolder: Executive

	measure 'New Customer Share' =
			DIVIDE ( [New Customer Orders], [Orders Placed] )
		formatString: "0.0%"
		displayFolder: Executive

	measure 'Direct Share' =
			DIVIDE (
				CALCULATE ( [Orders Placed], 'Orders Daily'[channel] = "direct" ),
				CALCULATE ( [Orders Placed], REMOVEFILTERS ( 'Orders Daily'[channel] ) )
			)
		formatString: "0.0%"
		displayFolder: Executive

	measure 'Revenue Placed vs Last Week' =
			// Change against the same weekday one week earlier. Needs the marked date table.
			VAR ThisWeek = [Revenue Placed]
			VAR LastWeek = CALCULATE ( [Revenue Placed], DATEADD ( 'Date'[Date], -7, DAY ) )
			RETURN
				DIVIDE ( ThisWeek - LastWeek, LastWeek )
		formatString: "0.0%"
		displayFolder: Executive

	measure 'Stock Lines' =
			COUNTROWS ( 'Stock Now' )   // store and product pairs
		formatString: "#,0"
		displayFolder: Inventory\Now

	measure 'Stock Units Available' =
			SUM ( 'Stock Now'[available] )
		formatString: "#,0"
		displayFolder: Inventory\Now

	measure 'Out of Stock Lines' =
			CALCULATE ( COUNTROWS ( 'Stock Now' ), KEEPFILTERS ( 'Stock Now'[available] <= 0 ) )
		formatString: "#,0"
		displayFolder: Inventory\Now

	measure 'Low Stock Lines' =
			// Above zero but below the reorder point. A column-to-column comparison needs FILTER, not a CALCULATE boolean.
			COUNTROWS (
				FILTER (
					'Stock Now',
					'Stock Now'[available] > 0 && 'Stock Now'[available] < 'Stock Now'[reorder_point]
				)
			)
		formatString: "#,0"
		displayFolder: Inventory\Now

	measure 'Out of Stock Rate' =
			DIVIDE ( [Out of Stock Lines], [Stock Lines] )
		formatString: "0.0%"
		displayFolder: Inventory\Now

	measure 'Stock Freshness (seconds)' =
			// Age of the newest stock row. Stock is recomputed after each Silver batch, so about one batch behind real time.
			DATEDIFF ( MAX ( 'Stock Now'[updated_at] ), NOW (), SECOND )
		formatString: "#,0"
		displayFolder: Inventory\Now

	measure 'Closing Stock' =
			// Semi-additive: the total of the LAST day that has data inside the filter context, never a sum over days.
			VAR LastDay = CALCULATE ( MAX ( 'Inventory Daily'[report_date] ) )
			RETURN
				CALCULATE ( SUM ( 'Inventory Daily'[closing_on_hand] ), 'Inventory Daily'[report_date] = LastDay )
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Units Sold' =
			SUM ( 'Inventory Daily'[units_sold] )
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Units Received' =
			SUM ( 'Inventory Daily'[units_received] )
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Units Shrunk' =
			SUM ( 'Inventory Daily'[units_shrunk] )
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Units Adjusted' =
			SUM ( 'Inventory Daily'[units_adjusted] )
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Oversold Units' =
			// Units customers asked for beyond the stock on the shelf (no reservations, so the app promised stock it did not have).
			SUM ( 'Inventory Daily'[oversold_units] )
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Shrinkage Rate' =
			DIVIDE ( [Units Shrunk], [Units Sold] + [Units Shrunk] )
		formatString: "0.0%"
		displayFolder: Inventory\Daily

	measure 'Net Stock Change' =
			[Units Received] - [Units Sold] - [Units Shrunk] + [Units Adjusted]
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Ended Out of Stock' =
			CALCULATE ( COUNTROWS ( 'Inventory Daily' ), KEEPFILTERS ( 'Inventory Daily'[ended_out_of_stock] = TRUE () ) )
		formatString: "#,0"
		displayFolder: Inventory\Daily

	measure 'Days of Cover' =
			// Closing stock divided by the average units sold per day with data. Blank when nothing sold.
			VAR Days = CALCULATE ( DISTINCTCOUNT ( 'Inventory Daily'[report_date] ) )
			VAR AvgDailySold = DIVIDE ( [Units Sold], Days )
			RETURN
				DIVIDE ( [Closing Stock], AvgDailySold )
		formatString: "#,0.0"
		displayFolder: Inventory\Daily

	measure 'OOS Views' =
			SUM ( 'OOS Demand Daily'[oos_views] )
		formatString: "#,0"
		displayFolder: Inventory\Demand on empty shelves

	measure 'OOS Add to Cart' =
			SUM ( 'OOS Demand Daily'[oos_add_to_cart] )
		formatString: "#,0"
		displayFolder: Inventory\Demand on empty shelves

	measure 'Served Demand Clicks' =
			SUM ( 'OOS Demand Daily'[served_clicks] )   // all landing clicks in served districts
		formatString: "#,0"
		displayFolder: Inventory\Demand on empty shelves

	measure 'OOS Demand Clicks' =
			SUM ( 'OOS Demand Daily'[oos_clicks] )   // the flagged part of the same clicks
		formatString: "#,0"
		displayFolder: Inventory\Demand on empty shelves

	measure 'Served Clicks' =
			SUM ( 'Marketing D1 Campaign'[served_clicks] )   // landing clicks in served districts: the denominator
		formatString: "#,0"
		displayFolder: Marketing and inventory

	measure 'OOS Clicks' =
			SUM ( 'Marketing D1 Campaign'[oos_clicks] )   // the part in minutes flagged out of stock: the numerator
		formatString: "#,0"
		displayFolder: Marketing and inventory

	measure 'OOS Click Share' =
			DIVIDE ( [OOS Clicks], [Served Clicks] )   // both counts come from the same table and population
		formatString: "0.0%"
		displayFolder: Marketing and inventory

	measure 'Exposed Spend' =
			// Estimated spend exposed to out-of-stock: spend x oos_clicks / served_clicks per campaign and day (the column is summed).
			// An estimate that assumes spend is spread evenly over served landing clicks; the flag is the stock when the minute was written.
			SUM ( 'Marketing D1 Campaign'[exposed_spend] )
		formatString: "#,0"
		displayFolder: Marketing and inventory

	measure 'Campaign Spend D1' =
			SUM ( 'Marketing D1 Campaign'[spend] )
		formatString: "#,0"
		displayFolder: Marketing and inventory

	measure 'Exposed Share of Spend' =
			DIVIDE ( [Exposed Spend], [Campaign Spend D1] )
		formatString: "0.0%"
		displayFolder: Marketing and inventory

	measure 'Revenue at Risk' =
			// Add-to-carts on empty shelves times price. 'Marketing D1 Product' keeps EVERY out-of-stock product per store, so the total
			// is the whole day's; put the Top N in the visual filter. Revenue the shelf could not serve, not lost revenue.
			SUM ( 'Marketing D1 Product'[revenue_at_risk] )
		formatString: "#,0"
		displayFolder: Marketing and inventory

	measure 'Express Orders' =
			SUM ( 'Express Daily'[orders] )
		formatString: "#,0"
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Express Delivered' =
			SUM ( 'Express Daily'[delivered] )
		formatString: "#,0"
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Express On Time' =
			SUM ( 'Express Daily'[on_time] )
		formatString: "#,0"
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Express Breaches' =
			// Always a number: zero breaches must show as 0, never as blank.
			COALESCE ( SUM ( 'Express Daily'[breached] ), 0 )
		formatString: "#,0"
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Express On-time Rate' =
			// On-time orders over orders that have been decided: delivered, or undelivered past their promise.
			DIVIDE ( [Express On Time], [Express On Time] + [Express Breaches] )
		formatString: "0.0%"
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Slowest Express Delivery (min)' =
			MAX ( 'Express Daily'[max_delivery_minutes] )
		formatString: "#,0.0"
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Average Express Delivery (min)' =
			// Weighted by delivered orders, not an average of daily averages.
			DIVIDE (
				SUMX ( 'Express Daily', 'Express Daily'[avg_delivery_minutes] * 'Express Daily'[delivered] ),
				[Express Delivered]
			)
		formatString: "#,0.0"
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Promise Met' =
			IF ( [Express Breaches] = 0, "Promise met", "Promise missed" )
		displayFolder: Express delivery (the 20-minute promise)

	measure 'Product Sessions' =
			SUM ( 'City Product Daily'[sessions_viewed] )
		formatString: "#,0"
		displayFolder: Products and cities

	measure 'Product Add to Carts' =
			SUM ( 'City Product Daily'[add_to_cart] )
		formatString: "#,0"
		displayFolder: Products and cities

	measure 'Product Units' =
			SUM ( 'City Product Daily'[units] )
		formatString: "#,0"
		displayFolder: Products and cities

	measure 'Product Revenue' =
			SUM ( 'City Product Daily'[revenue] )
		formatString: "#,0"
		displayFolder: Products and cities

	measure 'Product Cart Rate' =
			// Sessions that added the product to the cart, over sessions that viewed it.
			DIVIDE ( [Product Add to Carts], [Product Sessions] )
		formatString: "0.0%"
		displayFolder: Products and cities

	measure 'Lines Revenue' =
			SUM ( 'Order Lines'[line_total] )
		formatString: "#,0"
		displayFolder: Products and cities

	measure 'Units Ordered' =
			SUM ( 'Order Lines'[quantity] )
		formatString: "#,0"
		displayFolder: Products and cities

	measure 'Active Customers' =
			DISTINCTCOUNT ( Orders[customer_id] )
		formatString: "#,0"
		displayFolder: Customers and delivery

	measure 'Average Delivery Hours' =
			// Hours from order to delivery, over delivered orders only (undelivered orders have no delivery time).
			AVERAGE ( Orders[delivery_lead_hours] )
		formatString: "#,0.0"
		displayFolder: Customers and delivery

	measure 'First Attempt Delivery Rate' =
			// Delivered orders that arrived on the first attempt, over all delivered orders.
			DIVIDE (
				CALCULATE ( COUNTROWS ( Orders ), Orders[first_attempt_delivered] = TRUE () ),
				CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE () )
			)
		formatString: "0.0%"
		displayFolder: Customers and delivery

	measure 'Order Count' =
			// One row per order in 'Orders', so it follows the city, carrier, status and customer filters that
			// 'Orders Daily' (no city) cannot answer.
			COUNTROWS ( Orders )
		formatString: "#,0"
		displayFolder: Customers and delivery

	measure 'Order Revenue' =
			SUM ( Orders[order_total] )
		formatString: "#,0"
		displayFolder: Customers and delivery

	column Dummy
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Dummy

	partition _Measures = m
		mode: import
		source =
			let
				Source = #table(type table [Dummy = text], {})
			in
				Source
